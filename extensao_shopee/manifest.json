{
  "manifest_version": 3,
  "name": "Espelho de Live - Finalizar Shopee",
  "version": "1.3",
  "description": "Finaliza a transmissÃ£o na Shopee Live e pausa/encerra a live no Gerenciador de LIVE do TikTok Shop quando o painel Espelho de Live pede. SÃ³ funciona com o painel aberto neste computador.",
  "minimum_chrome_version": "116",
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://live.shopee.com.br/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["https://shop.tiktok.com/*"],
      "js": ["content_tiktok.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "permissions": ["scripting"],
  "host_permissions": ["https://live.shopee.com.br/*", "https://shop.tiktok.com/*"],
  "icons": { "16": "icone16.png", "48": "icone48.png", "128": "icone128.png" }
}
